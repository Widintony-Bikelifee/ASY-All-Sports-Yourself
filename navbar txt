    /* ── VENUES PAGE ─────────────────────────────────────────────────────────
   Layout estructural delegado a Bootstrap:
     - Header inner (flex, max-width, margin) → container + d-flex Bootstrap
     - Filters (flex, gap, flex-wrap)         → d-flex flex-wrap gap-2 Bootstrap
     - Media query de header inner            → Bootstrap breakpoints
   Aquí solo viven estilos de diseño/marca propios.
   ──────────────────────────────────────────────────────────────────────── */

/* ── Página ── */
.page-venues {
  background: var(--bg-dark);
  padding-top: var(--nav-h);
  min-height: 100vh;
}

/* ── Header ── */
.venues__header {
  background: var(--bg-dark2);
  border-bottom: 1px solid var(--border-dark);
  padding: 2rem 0; /* padding horizontal lo da .container */
}

/* Etiqueta de sección - pill verde */
.venues__section-tag {
  display: inline-block;
  background: var(--color-green-dim);
  color: var(--color-green);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 0.28rem 0.8rem;
  border-radius: var(--radius-full);
  margin-bottom: 0.5rem;
}

/* Título principal de la sección */
.venues__title {
  font-family: var(--font-display);
  font-size: var(--fs-2xl);
  font-weight: 900;
  text-transform: uppercase;
  color: var(--text-primary);
  margin-bottom: 0;
}

/* Contador de resultados */
.venues__count {
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.venues__count strong {
  color: var(--text-primary);
}

/* ── Filtros ── */
/* El styling de botones ahora lo maneja Bootstrap. */

/* ── Grid de cards (Bootstrap row/columns) ── */
.venues__grid {
  margin: 2rem auto 3rem;
}

/* ── Card ── */
.venue-card {
  background: var(--bg-card);
  overflow: hidden;
  cursor: pointer;
  transition:
    transform var(--transition),
    border-color var(--transition),
    box-shadow var(--transition);
}

.venue-card:hover {
  transform: translateY(-4px);
  border-color: rgba(46, 204, 80, 0.4);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* Card Image */
.venue-card__img {
  min-height: 190px;
  overflow: hidden;
}

.venue-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Card Body */
.venue-card__name {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  font-weight: 800;
  text-transform: uppercase;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
}

/* Tags y ubicación usan utilidades Bootstrap en el HTML. */

.venue-card__price {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 900;
  color: var(--color-green);
  line-height: 1;
}

/* Botón reservar */

.venues__empty-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.venues__empty h3 {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 0.4rem;
  color: var(--text-secondary);
}


/* ══ MODAL DE RESERVA (2 pasos) ══════════════════════════════════════════
   Modal custom (no Bootstrap Modal) para conservar el wizard de 2 pasos
   y las animaciones de entrada. El JS usa Venues.openModal() / closeModal().
   ═══════════════════════════════════════════════════════════════════════ */

.reserva-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  padding: 1rem;
}
.reserva-modal-overlay.open {
  opacity: 1;
  visibility: visible;
}

.reserva-modal {
  background: var(--bg-white);
  border-radius: 18px;
  width: 100%;
  max-width: 500px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
  transform: translateY(24px) scale(0.97);
  transition: all 0.28s ease;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 92vh;
}
.reserva-modal-overlay.open .reserva-modal {
  transform: translateY(0) scale(1);
}

/* Barra de progreso */
.rmodal-progress {
  display: flex;
  height: 4px;
  background: var(--border-light);
}
.rmodal-progress__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-green), #34d399);
  transition: width 0.35s ease;
}

/* Header del modal */
.rmodal-header {
  padding: 1.4rem 1.6rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px solid var(--border-light);
}
.rmodal-step-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--color-green-dark);
  margin-bottom: 0.3rem;
}
.rmodal-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--text-dark);
  line-height: 1.2;
}
.rmodal-close {
  background: var(--bg-light);
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.2s ease;
  flex-shrink: 0;
}
.rmodal-close:hover {
  background: var(--border-dark);
  color: var(--text-dark);
}

/* Info del espacio */
.rmodal-venue-info {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 1rem 1.6rem;
  background: var(--bg-light);
  border-bottom: 1px solid var(--border-light);
}
.rmodal-venue-icon {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  background: var(--color-green-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  flex-shrink: 0;
}
.rmodal-venue-name {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.05rem;
  color: var(--text-dark);
  display: block;
}
.rmodal-venue-meta {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* Body del modal */
.rmodal-body {
  padding: 1.4rem 1.6rem;
  overflow-y: auto;
  flex: 1;
}

/* Pasos */
.rmodal-step        { display: none; }
.rmodal-step.active { display: block; }

/* Formularios */
.rmodal-form-group { margin-bottom: 1.1rem; }
.rmodal-form-group label {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 0.4rem;
}
.rmodal-input {
  width: 100%;
  padding: 0.65rem 1rem;
  border: 1.5px solid var(--border-dark);
  border-radius: 10px;
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--text-dark);
  background: var(--bg-white);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.rmodal-input:focus {
  outline: none;
  border-color: var(--color-green);
  box-shadow: 0 0 0 3px rgba(46, 204, 80, 0.12);
}
.rmodal-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.85rem;
}
.rmodal-error {
  color: #dc2626;
  font-size: 0.8rem;
  font-weight: 600;
  margin-top: 0.8rem;
  min-height: 1.2em;
}

/* Paso 2 – resumen */
.rmodal-summary {
  background: var(--bg-light);
  border-radius: 12px;
  padding: 1.1rem 1.25rem;
  margin-bottom: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}
.rmodal-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.86rem;
}
.rmodal-summary-row .lbl { color: var(--text-muted); font-weight: 500; }
.rmodal-summary-row .val { font-weight: 700; color: var(--text-dark); }
.rmodal-summary-row--total .val {
  color: var(--color-green-dark);
  font-size: 1.15rem;
  font-family: var(--font-display);
}
.rmodal-summary__divider {
  height: 1px;
  background: var(--border-dark);
  margin: 0.2rem 0;
}

/* Método de pago */
.rmodal-payment-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 0.7rem;
  display: block;
}
.rmodal-payment-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.7rem;
}
.rmodal-payment-opt {
  border: 2px solid var(--border-dark);
  border-radius: 12px;
  padding: 0.85rem 0.9rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  transition: all 0.2s ease;
  background: var(--bg-white);
  position: relative;
}
.rmodal-payment-opt:hover    { border-color: var(--color-green); }
.rmodal-payment-opt.selected { border-color: var(--color-green); background: rgba(46, 204, 80, 0.06); }
.rmodal-payment-opt input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
.rmodal-payment-opt__icon  { font-size: 1.4rem; line-height: 1; }
.rmodal-payment-opt__text  { display: flex; flex-direction: column; }
.rmodal-payment-opt__name  { font-weight: 700; font-size: 0.83rem; color: var(--text-dark); }
.rmodal-payment-opt__sub   { font-size: 0.7rem; color: var(--text-muted); }
.rmodal-payment-check {
  margin-left: auto;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid var(--border-dark);
  background: white;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.rmodal-payment-opt.selected .rmodal-payment-check {
  background: var(--color-green);
  border-color: var(--color-green);
}
.rmodal-payment-opt.selected .rmodal-payment-check::after {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: white;
}

/* Footer del modal */
.rmodal-footer {
  padding: 1.1rem 1.6rem;
  border-top: 1px solid var(--border-light);
  display: flex;
  gap: 0.8rem;
  justify-content: flex-end;
}
.rmodal-btn-back {
  padding: 0.65rem 1.3rem;
  border: 1.5px solid var(--border-dark2);
  border-radius: 99px;
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--text-dark);
  background: transparent;
  cursor: pointer;
  transition: all 0.2s;
}
.rmodal-btn-back:hover { background: var(--bg-light); }
.rmodal-btn-next {
  padding: 0.65rem 1.6rem;
  border: none;
  border-radius: 99px;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: 0.4px;
  background: var(--color-green);
  color: #000;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}
.rmodal-btn-next:hover {
  background: var(--color-green-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(46, 204, 80, 0.3);
}
.rmodal-btn-next:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

/* Estado de éxito */
.rmodal-success {
  display: none;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 2.5rem 1.6rem;
  gap: 1rem;
}
.rmodal-success.active { display: flex; }
.rmodal-success__icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: rgba(46, 204, 80, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
}
.rmodal-success__title {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 900;
  color: var(--text-dark);
}
.rmodal-success__text {
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.6;
}
.rmodal-success__btn {
  padding: 0.75rem 2rem;
  border: none;
  border-radius: 99px;
  background: var(--color-green);
  color: #000;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.2s;
}
.rmodal-success__btn:hover { background: var(--color-green-dark); }
